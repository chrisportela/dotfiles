#compdef wt

# Candidates come from `wt __complete` (registered worktrees via
# `git worktree list --porcelain`, not directory listings), so nested
# slashed names like cportela/feature complete fully. _multi_parts gives
# git-style segment-by-segment completion on '/'.

_wt_branches() {
  local -a bs
  bs=(${(f)"$(wt __complete branches 2>/dev/null)"})
  (( $#bs )) && _multi_parts -S '' / bs
}

_wt_worktrees() {
  local -a wts
  wts=(${(f)"$(wt __complete worktrees 2>/dev/null)"})
  (( $#wts )) && _multi_parts -S '' / wts
}

_wt() {
  local state

  _arguments -C \
    '--dry-run[print planned commands instead of executing]' \
    '1: :->command' \
    '*:: :->args'

  case $state in
    command)
      _values 'subcommand' \
        'init[setup .worktrees and exclude]' \
        'add[create a worktree]' \
        'open[reopen tmux workspaces for existing worktrees]' \
        'ls[list active worktrees]' \
        'rm[remove a worktree]' \
        'help[show help]'
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--no-direnv[skip direnv allow / devshell priming]' \
            '--no-env[skip copying .env files]' \
            '--no-tmux[skip tmux window creation]' \
            '--session[create a detached tmux session instead]' \
            '--dry-run[print planned commands instead of executing]' \
            ': :_wt_branches'
          ;;
        open)
          _arguments \
            '--session[create a detached tmux session instead]' \
            '--dry-run[print planned commands instead of executing]' \
            ': :_wt_worktrees'
          ;;
        rm)
          _arguments \
            '--no-tmux[skip killing the matching tmux window]' \
            '--dry-run[print planned commands instead of executing]' \
            ': :_wt_worktrees'
          ;;
      esac
      ;;
  esac
}

_wt "$@"
